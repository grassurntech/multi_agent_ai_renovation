# Copy to .env and fill in real values locally. Never commit .env.
# Placeholders only: this file is checked by tests/test_repo_hygiene.py.

RENO_CURRENCY=USD
RENO_APPROVAL_THRESHOLD=15000
RENO_PREFERRED_GRADE=better

# Model provider key (phase 2). Get your own; never paste it anywhere public.
GOOGLE_API_KEY=your-google-api-key

# Web app session secret (phase 3). Generate a long random value.
RENO_SECRET_KEY=changeme
